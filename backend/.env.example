# Replace YOUR_PASSWORD with your local PostgreSQL password.
# URL-encode special characters in the username/password (for example, @ becomes %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/learning_platform?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Additional exact origins, comma-separated. Production never adds local defaults.
FRONTEND_ORIGINS=""
# Set locally only when running npm run instructor:provision. Never commit a real password.
INSTRUCTOR_BOOTSTRAP_PASSWORD=""
